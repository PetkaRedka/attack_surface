# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_BASE=http://localhost:8000/v1  # Uncomment for self-hosted models

# DeepSeek API (optional, if using DeepSeek models)
# DEEPSEEK_API_KEY2=your_deepseek_api_key_here

# LLM-минимизация EXT (External Entry Points)
# Системный промпт для EXT минимизатора
EXT_MINIMIZER_SYSTEM_ROLE=Вы — эксперт по анализу поверхности атаки программного обеспечения.

# Задача для EXT минимизатора
EXT_MINIMIZER_TASK=Сгруппируйте похожие внешние точки входа (EXT) по их функциональности и типу интерфейса.

# Правила группировки EXT
EXT_MINIMIZER_RULES=1. Группируйте функции с одинаковым типом внешнего ввода.\n2. Объединяйте похожие HTTP endpoints.\n3. Сохраняйте уникальные интерфейсы отдельно.\n4. Для каждой группы выберите представительное имя.

# Logging
LOG_LEVEL=INFO
LOG_FILE=./log/attack_surface.log
